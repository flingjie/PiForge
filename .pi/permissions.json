{
  "rules": [
    { "action": "deny", "tool": "bash", "command": "rm *-rf*" },
    { "action": "deny", "tool": "bash", "command": "rm *-r *" },
    { "action": "deny", "tool": "bash", "command": "sudo *" },
    { "action": "deny", "tool": "bash", "command": "chmod *777*" },
    { "action": "deny", "tool": "bash", "command": "chown *" },
    { "action": "deny", "tool": "bash", "command": "> /dev/*" },
    { "action": "deny", "tool": "bash", "command": "dd if=*" },
    { "action": "deny", "tool": "bash", "command": "mkfs*" },
    { "action": "deny", "tool": "bash", "command": "*|*sh*" },
    { "action": "deny", "tool": "bash", "command": "*|*bash*" },
    { "action": "deny", "tool": "bash", "command": ":(){ :|:& };:*" },

    { "action": "allow", "tool": "read" },
    { "action": "allow", "tool": "grep" },
    { "action": "allow", "tool": "find" },
    { "action": "allow", "tool": "ls" },
    { "action": "allow", "tool": "write", "path": "./**" },
    { "action": "allow", "tool": "write", "path": "/tmp/**" },
    { "action": "allow", "tool": "edit", "path": "./**" },
    { "action": "allow", "tool": "edit", "path": "/tmp/**" },
    { "action": "allow", "tool": "bash", "command": "git *" },
    { "action": "allow", "tool": "bash", "command": "npm *" },
    { "action": "allow", "tool": "bash", "command": "npx *" },
    { "action": "allow", "tool": "bash", "command": "yarn *" },
    { "action": "allow", "tool": "bash", "command": "pnpm *" },
    { "action": "allow", "tool": "bash", "command": "node *" },
    { "action": "allow", "tool": "bash", "command": "ls*" },
    { "action": "allow", "tool": "bash", "command": "cat *" },
    { "action": "allow", "tool": "bash", "command": "head *" },
    { "action": "allow", "tool": "bash", "command": "tail *" },
    { "action": "allow", "tool": "bash", "command": "grep*" },
    { "action": "allow", "tool": "bash", "command": "find *" },
    { "action": "allow", "tool": "bash", "command": "wc *" },
    { "action": "allow", "tool": "bash", "command": "sort *" },
    { "action": "allow", "tool": "bash", "command": "echo *" },
    { "action": "allow", "tool": "bash", "command": "mkdir*" },
    { "action": "allow", "tool": "bash", "command": "touch *" },
    { "action": "allow", "tool": "bash", "command": "cp *" },
    { "action": "allow", "tool": "bash", "command": "mv *" },
    { "action": "allow", "tool": "bash", "command": "rm *" },
    { "action": "allow", "tool": "bash", "command": "which *" },
    { "action": "allow", "tool": "bash", "command": "command *" },
    { "action": "allow", "tool": "bash", "command": "pwd*" },
    { "action": "allow", "tool": "bash", "command": "cd*" },
    { "action": "allow", "tool": "bash", "command": "env*" },
    { "action": "allow", "tool": "bash", "command": "export *" },
    { "action": "allow", "tool": "bash", "command": "date*" },
    { "action": "allow", "tool": "bash", "command": "cargo *" },
    { "action": "allow", "tool": "bash", "command": "go *" },
    { "action": "allow", "tool": "bash", "command": "python3 *" },
    { "action": "allow", "tool": "bash", "command": "pip*" },
    { "action": "allow", "tool": "bash", "command": "make *" },
    { "action": "allow", "tool": "bash", "command": "curl *" },
    { "action": "allow", "tool": "bash", "command": "ps *" },
    { "action": "allow", "tool": "bash", "command": "df *" },
    { "action": "allow", "tool": "bash", "command": "du *" },
    { "action": "allow", "tool": "bash", "command": "docker *" },
    { "action": "allow", "tool": "bash", "command": "gh *" },

    { "action": "deny", "tool": "write" },
    { "action": "deny", "tool": "edit" },
    { "action": "deny", "tool": "bash" }
  ]
}
